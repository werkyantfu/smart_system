{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Backend (Laravel)",
      "type": "shell",
      "command": "php artisan serve",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🎨 Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "🗄️ Run Migrations",
      "type": "shell",
      "command": "php artisan migrate",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build"
    },
    {
      "label": "🌱 Seed Database",
      "type": "shell",
      "command": "php artisan db:seed",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build"
    },
    {
      "label": "🧪 Run Tests (Backend)",
      "type": "shell",
      "command": "php artisan test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test"
    },
    {
      "label": "🔨 Build Frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build"
    },
    {
      "label": "🎨 Format Code (Pint)",
      "type": "shell",
      "command": "./vendor/bin/pint",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "build"
    }
  ]
}
