# ============================================
# Smart School Management System - .gitignore
# ============================================

# === OS Files ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# === IDE / Editor ===
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# === Node / Frontend ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
dist-ssr/
*.local
.vite/
coverage/
*.lcov

# === Laravel / Backend ===
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*
/backend/bootstrap/cache/*
!/backend/storage/.gitignore
!/backend/bootstrap/cache/.gitignore

# === Environment Files ===
.env
.env.backup
.env.production
.env.local
.env.*.local
*.env

# === Database ===
*.sqlite
*.sqlite3
*.db
/backend/database/database.sqlite

# === Logs ===
*.log
logs/
npm-debug.log*
yarn-error.log*

# === Cache ===
.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.phpactor.json

# === Build Output ===
/build/
/out/
*.tsbuildinfo

# === Documents ===
diagrams/*.tmp
diagrams/*.bak
~$*.docx
~$*.xlsx
~$*.pptx

# === Secrets ===
*.pem
*.key
*.crt
!public/*.crt

# === Backup ===
*.bak
*.backup
*.old
backup/

# === Temporary ===
tmp/
temp/
*.tmp

# === Composer ===
/backend/vendor/
/backend/composer.phar

# === PHPUnit ===
/backend/.phpunit.cache
/backend/.phpunit.result.cache

# === Frontend Build ===
/frontend/dist/
/frontend/.vite/
/frontend/node_modules/

# === Storage ===
/backend/storage/app/public/*
!/backend/storage/app/public/.gitignore
/backend/storage/app/private/*
!/backend/storage/app/private/.gitignore

# === Uploads ===
/backend/public/uploads/*
!/backend/public/uploads/.gitkeep

# === Docs ===
*.pdf.bak