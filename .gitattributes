# ============================================
# Git Attributes - Smart School Management System
# ============================================

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# === Source Code ===
*.php    text diff=php
*.js     text
*.ts     text
*.vue    text
*.jsx    text
*.tsx    text
*.json   text
*.css    text
*.scss   text
*.sass   text
*.less   text
*.html   text
*.xml    text
*.yml    text
*.yaml   text

# === Documentation ===
*.md     text
*.txt    text
*.rst    text

# === Shell Scripts ===
*.sh     text eol=lf

# === Windows Scripts ===
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# === Binary Files (do not modify) ===
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.svg    text
*.webp   binary
*.pdf    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.7z     binary

# === Fonts ===
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary

# === Linguist (GitHub language detection) ===
backend/vendor/*         linguist-vendored
frontend/node_modules/*  linguist-vendored
*.min.js                 linguist-generated
*.min.css                linguist-generated
composer.lock            linguist-generated
package-lock.json        linguist-generated
yarn.lock                linguist-generated